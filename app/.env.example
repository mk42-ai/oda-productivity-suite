# UAE AI National Intelligence Command Centre — Concept Demonstration (not an official government system)
# ---- Server-side only (never NEXT_PUBLIC_, never logged, never in the client bundle) ----
ONDEMAND_BASE_URL=https://api.on-demand.io
# OnDemand apikey — sent as the `apikey` header by /api/chat, /api/briefing and /api/ondemand/*.
ONDEMAND_API_KEY=
# ---- Public (browser) configuration — no secrets ----
NEXT_PUBLIC_DEFAULT_EXTERNAL_USER_ID=uae-cc-demo
NEXT_PUBLIC_SITE_URL=
# Chat transport: proxy (default for this build — every turn goes through POST /api/chat with the server key) | direct (browser → api.on-demand.io, needs a browser key).
NEXT_PUBLIC_CHAT_TRANSPORT=proxy
NEXT_PUBLIC_ONDEMAND_API_KEY=
MEDIA_ALLOW_VIDEO=0
INGEST_SECRET=
VOICE_WORKFLOW_ID=
