# ODA Productivity Suite — environment variables (copy to .env and fill in real values)
# .env is gitignored — never commit secrets. The API key is read ONLY server-side (server/env.js).

# REQUIRED — OnDemand platform API key (sent as the `apikey` header on every OnDemand call)
ONDEMAND_API_KEY=

# OPTIONAL — OnDemand API base URL (default: https://api.on-demand.io)
ONDEMAND_BASE_URL=

# OPTIONAL — backend listen port (default: 8080)
PORT=

# OPTIONAL — publicly reachable base URL of THIS deployment (e.g. https://your-app.example)
# Required only for speech-to-text: the OnDemand service fetches the mic clip
# back from /api/audio/:id, so the server must be publicly reachable.
PUBLIC_BASE_URL=

# OPTIONAL — directory for the persisted session snapshot (default: server/data)
DATA_DIR=
