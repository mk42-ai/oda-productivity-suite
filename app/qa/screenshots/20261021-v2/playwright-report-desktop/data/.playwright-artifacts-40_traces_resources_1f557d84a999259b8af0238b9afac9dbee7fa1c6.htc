1e:["$","section",null,{"className":"card min-w-0 p-4 sm:p-5","data-testid":"m-pipeline","children":[["$","div",null,{"className":"mb-3 flex items-center justify-between gap-2","children":[["$","h2",null,{"className":"text-sm font-semibold tracking-tight","children":"Pipeline (all AI steps via OnDemand)"}],"$undefined"]}],["$","ol",null,{"className":"ml-4 list-decimal space-y-1 text-sm text-muted","children":[["$","li",null,{"children":"Research: OnDemand plugins â€” Perplexity, GPT Search, Internet search, Wikipedia, HuggingFace â€” 125 calls captured in the step 1â€“8 plugin payload."}],["$","li",null,{"children":"Org intel + source verification: one OnDemand chat session per organisation (POST /chat/v1/sessions/{id}/query, predefined-gpt-5.6-luna) structures a dossier from research snippets + mission-brief seed facts; every cited URL is then checked against the research corpus and removed if absent."}],["$","li",null,{"children":"Sentiment ingestion + entity extraction: OnDemand agent extracts attributable statements and location evidence; de-duplicated; then topic classification into 7 classes + topic clusters with confidence."}],["$","li",null,{"children":"News retrieval + relationship mapping: OnDemand agent extracts dated events, radar rings and org-to-org edges; ownership edges from the mission brief."}],["$","li",null,{"children":"Briefings and executive chat: live OnDemand sessions at request time, grounded on this namespace, with the Perplexity plugin for fresh web research."}]]}]]}]
1f:["$","section",null,{"className":"card min-w-0 p-4 sm:p-5","data-testid":"m-limits","children":[["$","div",null,{"className":"mb-3 flex items-center justify-between gap-2","children":[["$","h2",null,{"className":"text-sm font-semibold tracking-tight","children":"Limitations"}],"$undefined"]}],["$","ul",null,{"className":"ml-4 list-disc space-y-1 text-sm text-muted","children":[["$","li",null,{"children":"Sentiment records are a purposive sample of public, attributable statements gathered via OnDemand research plugins (Perplexity, GPT Search, Internet search, Reddit/HN pages surfaced by those tools) between 2025-08 and 2026-10-20. It is NOT a population survey and does not measure national opinion."}],["$","li",null,{"children":"Native X, TikTok, YouTube and Instagram ingestion was not run for this namespace (those platforms appear only when quoted in reporting)."}],["$","li",null,{"children":"Some leaders, dates and ownership splits conflict between sources (e.g. TII CEO: Dr Ray O. Johnson named Sep 2026 vs earlier sources citing Najwa Aaraj). Conflicts are flagged on the dossier, not resolved silently."}],["$","li",null,{"children":"HuggingFace search results for inception42 and IFM do not return download/like counts; shown as n/a. The inceptionai, LLM360, core42 and g42 HF orgs returned 0 models."}],["$","li",null,{"children":"Lucidya (Riyadh HQ) is excluded; â€œAIREV / airev.aero / Rani Plautâ€ is a different entity and was rejected."}],["$","li",null,{"children":"No live data is fabricated: where a value is missing the UI says â€œunavailableâ€."}]]}]]}]
