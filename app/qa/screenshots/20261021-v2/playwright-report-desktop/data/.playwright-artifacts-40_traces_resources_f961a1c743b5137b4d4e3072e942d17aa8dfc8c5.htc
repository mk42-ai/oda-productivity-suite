"p",null,{"className":"text-[11px] font-medium uppercase tracking-[0.12em] text-muted","children":"Categories"}],["$","p",null,{"className":"mt-1 text-2xl font-semibold tabular-nums tracking-tight text-[#0D0D0D]","children":16}],"$undefined"]}]]}],["$","$L1d",null,{"items":[{"id":"nec1dd46238","headline":"GITEX GLOBAL 2026 scheduled for 7â€“11 December 2026 at Expo City Dubai (moved from October / DWTC)","date":"2026-12-07","publisher":"GITEX","url":"https://www.gitex.com","summary":"GITEX GLOBAL 2026 runs 7â€“11 December 2026 at Expo City Dubai. October 2026 items are therefore not 'at GITEX'; Ai Everything Abu Dhabi was 6â€“7 Oct 2026 at ADNEC.","category":"other","orgs":[],"also":1},{"id":"n2f45ba268f","headline":"Jais 3 announced","date":"2026-10-15","publisher":"","url":"","summary":"The mission brief lists Jais 3 on this date; it provides no further details.","category":"models","orgs":[],"also":1},{"id":"ne586e429b1","headline":"UAE launches Jais 3 Arabic-native AI","date":"2026-10-15","publisher":"Gulf News","url":"https://gulfnews.com/uae/uae-launches-jais-3-arabic-native-ai-for-speech-writing-and-agents-1.500711935","summary":"Jais 3, described as part of the Jais family built on K2 Horizon, includes six language models and an Arabic speech-recognition model covering Modern Standard and dialectal Arabic.","category":"models","orgs":[{"id":"inception","name":"Inception (Inception42, G42)"},{"id":"mbzuai","name":"Mohamed bin Zayed University of Artificial Intelligence"}],"also":1},{"id":"nf769c42d1b","headline":"Jais 3 Arabic-native AI model announced","date":"2026-10-15","publisher":"Gulf News","url":"https://gulfnews.com/uae/uae-launches-jais-3-arabic-native-ai-for-speech-writing-and-agents-1.500711935","summary":"The brief identifies Jais 3 as an Arabic-native model for speech, writing and agents, built on K2 Horizon; the article also connects the model to MBZUAI, IFM and Inception42.","category":"models","orgs":[{"id":"inception","name":"Inception (Inception42, G42)"},{"id":"mbzuai","name":"Mohamed bin Zayed University of Artificial Intelligence"}],"also":0},{"id":"nfcf5ea1036","headline":"MBZUAIâ€™s Institute of Foundation Models and Inception42 launch Jais 3","date":"2026-10-15","publisher":"MBZUAI","url":"https://mbzuai.ac.ae/news-events/news/mbzuais-institute-foundation-models-inception42-launch-jais-3-arabic-native-ai","summary":"Jais 3 comprises six open Arabic models (0.9Bâ€“375B parameters) and a speech-recognition model, supports multiple dialects, and is built on K2 Horizon. Benchmarks and checkpoints were made public.","category":"models","orgs":[{"id":"cerebras-uae","name":"Cerebras Systems"},{"id":"inception","name":"Inception (Inception42, G42)"},{"id":"mbzuai","name":"Mohamed bin Zayed University of Artificial Intelligence"}],"also":1},{"id":"ndfd2853469","headline":"Inception describes AI-assisted investment and procurement workflows at SIF 2026","date":"2026-10-14","publisher":"WAM","url":"https://www.bignewsnetwork.com/news/279374613/microsoft-uae-g42-explore-human-led-agent-operated-businesses-at-sif-2026","summary":"Inception (G42) described AI testing investment proposals and supporting procurement workflows. Human reviewers check recommendations and can override proposed actions.","category":"other","orgs":[{"id":"inception","name":"Inception (Inception42, G42)"}],"also":0},{"id":"n8c7465dd19","headline":"Falcon-Emirati 7B announced","date":"2026-10-07","publisher":"","url":"","summary":"The mission brief lists Falcon-Emirati 7B on this date; it provides no further details.","category":"models","orgs":[{"id":"tii","name":"Technology Innovation Institute"}],"also":3},{"id":"n3caa531774","headline":"Falcon-Emirati model launched","date":"2026-10-07","publisher":"Gulf Business","url":"https://gulfbusiness.com/en/2026/artificial-intelligence/uae-tii-falcon-emirati-arabic-ai-model/","summary":"TII launched Falcon-Emirati, a 7-billion-parameter model designed for Emirati Arabic, alongside speech-recognition and Arabic-document models, according to the article and mission brief.","category":"models","orgs":[{"id":"atrc","name":"Advanced Technology Research Council"},{"id":"tii","name":"Technology Innovation Institute"}],"also":0},{"id":"n9d792c61e3","headline":"Abu Dhabi DGE leader discusses an AI-native state at Ai Everything Abu Dhabi","date":"2026-10-07","publisher":"Ai Everything Abu Dhabi","url":"https://www.facebook.com/AiEverythingAbuDhabi/posts/ai-progress-is-an-ecosystem-effort-he-ruba-al-hassan-director-general-department/1422484696654163/","summary":"DGE Director General Ruba Al Hassan discussed ecosystem collaboration among universities, technology companies, research institutes, investors and startups to advance AI in Abu Dhabi. (Ai Everything Abu Dhabi, ADNEC, 6â€“7 Oct 2026.)","category":"policy","orgs":[{"id":"dge","name":"Department of Government Enablement (DGE), Abu Dhabi"}],"also":0},{"id":"n1fddffc9a9","headline":"Saal.ai showcases AI and big-data technologies at AI Everything Abu Dhabi","date":"2026-10-06","publisher":"WAM","url":"https://www.wam.ae/en/article/c2lundc-saalai-highlights-rapid-growth-uaes-sector","summary":"CEO Vikraman Poduval spoke at AI Everything Abu Dhabi about Saal.aiâ€™s technologies, including big data and AI agents.","category":"other","orgs":[{"id":"saal-ai","name":"Saal.ai"}],"also":0},{"id":"n683ca83ee7","headline":"Dubai Future Foundation Agentic AI accelerator announced","date":"2026-10-05","publisher":"Dubai Future Foundation","url":"https://www.dubaiprnetwork.com/technology-news/194304-dubai-future-foundation-launches-agentic-ai-for-government-services-accelerator","summary":"The mission brief lists a Dubai Future Foundation Agentic AI accelerator on this date.","category":"talent","orgs":[{"id":"dcai","name":"Dubai Centre for Artificial Intelligence"},{"id":"dff","name":"Dubai Future Foundation"},{"id":"digital-dubai","name":"Digital Dubai"}],"also":4},{"id":"nf34c3460e2","headline":"DFF launches Agentic AI accelerator","date":"2026-10-05","publisher":"Mission brief","url":"","summary":"The brief reports that Dubai Future Foundation launched an Agentic AI accelerator.","category":"talent","orgs":[{"id":"dff","name":"Dubai Future Foundation"}],"also":2},{"id":"ne39511cd80","headline":"Microsoft and G42 announce data-centre expansion via Khazna","date":"2026-10","publisher":"G42","url":"","summary":"G42 announced a 200 MW data-centre capacity expansion via Khazna, expected to start coming online before the end of 2026, as part of a deeper Microsoft-G42 partnership.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"}],"also":0},{"id":"nbf4317923e","headline":"G42 and global technology companies launch Stargate UAE","date":"2026-10","publisher":"G42","url":"https://www.g42.ai/resources/news/global-tech-alliance-launches-stargate-uae","summary":"The announcement describes a 1 GW Abu Dhabi compute cluster within a 5 GW UAE-US AI Campus; the first 200 MW was planned for 2026. G42 builds via Khazna; OpenAI and Oracle operate it, with NVIDIA, Cisco and SoftBank involved.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"},{"id":"m42","name":"M42"}],"also":0},{"id":"n68af7997df","headline":"Global Tech Alliance Launches Stargate UAE","date":"2026-10","publisher":"G42","url":"https://www.g42.ai/resources/news/global-tech-alliance-launches-stargate-uae","summary":"The announcement describes a 1 GW AI compute cluster in Abu Dhabi within a 5 GW UAE-US AI Campus, with the first 200 MW expected in 2026. G42 builds via Khazna; OpenAI and Oracle operate it, with NVIDIA, Cisco and SoftBank involved.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"}],"also":0},{"id":"n9dd795f1c7","headline":"Microsoft and G42 Accelerate UAEâ€™s Digital Future with Major Data Centre Expansion","date":"2026-10","publisher":"G42","url":"","summary":"Microsoft and G42 announced 200 MW of additional data centre capacity via Khazna, expected to start coming online before the end of 2026.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"}],"also":0},{"id":"n8455c1fd19","headline":"Falcon model family overview highlights TIIâ€™s foundation-model work","date":"2026-09-30","publisher":"iTechGuides","url":"https://www.itechguides.com/uaes-tii-builds-falcon-ai-models-to-challenge-big-tech-what-the-evidence-shows/","summary":"The overview discusses TIIâ€™s Falcon model family, including Arabic and smaller-scale models, and notes release, licensing and technical claims while cautioning against assuming displacement of large technology providers.","category":"models","orgs":[{"id":"tii","name":"Technology Innovation Institute"}],"also":0},{"id":"n572743f241","headline":"EDGE presents air defence and counter-drone capabilities at ADEX 2026","date":"2026-09-30","publisher":"Zawya","url":"https://www.zawya.com/en/press-release/companies-news/edge-returns-to-adex-2026-with-layered-air-defence-and-counter-drone-capability-1322054","summary":"EDGEâ€™s ADEX display, scheduled for 30 Septemberâ€“2 October 2026, features layered air defence, counter-drone capabilities, electronic warfare, loitering munitions and guided weapons.","category":"defence","orgs":[{"id":"edge","name":"EDGE Group"}],"also":0},{"id":"nfa36be88ac","headline":"MGX-backed consortium eyes another data-center portfolio","date":"2026-09-25","publisher":"EnterpriseAM","url":"https://enterpriseam.com/uae/2026/09/25/this-morning-iranian-flights-suspended-mgx-backed-consortium-eyes-another-data-center-portfolio-mubadala-eyes-stake-in-italian-turbine-maker/","summary":"EnterpriseAM reports that an MGX-backed consortium is considering another data-center portfolio; the excerpt provides no further deal details.","category":"infrastructure","orgs":[{"id":"mgx","name":"MGX"}],"also":0},{"id":"n1a534788ef","headline":"PureHealth launches AI system to process Daman insurance documents","date":"2026-09-21","publisher":"HealthTechAsia","url":"https://healthtechasia.co/purehealth-launches-ai-system-to-process-daman-insurance-documents/","summary":"PureHealth launched a system using LLMs and document classification to automate Daman policy applications, endorsements and claims. It serves more than 3 million members and is intended to reduce errors and turnaround times.","category":"health","orgs":[{"id":"purehealth","name":"PureHealth"}],"also":0},{"id":"nde1c9ddfdd","headline":"UAE Government and Dell Technologies collaborate on agentic AI capabilities","date":"2026-09-20","publisher":"WAM","url":"https://www.wam.ae/en/article/c2cbp0j-artificial-intelligence-office-collaborates-with","summary":"The UAE Governmentâ€™s Artificial Intelligence Office launched a strategic collaboration with Dell Technologies to build national capabilities and develop practical agentic AI applications for government operations and services.","category":"partnership","orgs":[],"also":0},{"id":"n5d70d2094c","headline":"PureHealth launches AI solution for Daman healthcare documents","date":"2026-09-18","publisher":"Abu Dhabi Media Office","url":"https://www.mediaoffice.abudhabi/en/health/purehealth-launches-ai-powered-solution-to-enhance-access-to-healthcare-services-for-daman-members/","summary":"The solution will automate document processing for Daman, handling more than 60 million documents annually, converting over 80% into structured data and reducing processing times from days to minutes.","category":"health","orgs":[{"id":"purehealth","name":"PureHealth"}],"also":1},{"id":"nde28c2a3d0","headline":"Stargate UAE phase-one enclosure milestone","date":"2026-09-13","publisher":"The Gulf Tape","url":"https://thegulftape.com/articles/stargate-uae","summary":"The report says two 100 MW buildings had been enclosed by August, with Khazna still targeting an end-2026 customer handover for phase one of the 1 GW cluster.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"},{"id":"m42","name":"M42"}],"also":0},{"id":"n13524742a2","headline":"UAE announces $1 billion French space AI project with Mistral","date":"2026-09-09","publisher":"Le Monde","url":"https://www.lemonde.fr/en/economy/article/2026/09/09/uae-commits-1-billion-to-french-space-ai-project_6757342_19.html","summary":"The mission brief describes a $1 billion UAE-French space AI project involving Mistral.","category":"space","orgs":[],"also":10},{"id":"ne3cd2a0cd5","headline":"Stargate UAE data-centre expansion and Microsoft-G42 capacity plans","date":"2026-09-09","publisher":"Gulf Business Review","url":"https://gulfbusinessreview.com/technology/uae-data-center-tracker-2026","summary":"The tracker reports Stargate UAEâ€™s 1 GW Abu Dhabi compute target, with 200 MW expected online in 2026, and a 200 MW Microsoft-G42 expansion via Khazna Data Centers.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"}],"also":1},{"id":"n1860e6e509","headline":"Micropolis Robotics showcases UAE-developed Physical AI alongside Dubai Police at AIM Congress","date":"2026-09-07","publisher":"GlobeNewswire via Yahoo Finance","url":"https://finance.yahoo.com/technology/ai/articles/micropolis-robotics-brings-uae-developed-134900401.html","summary":"Micropolis showcased autonomous robotic platforms alongside Dubai Police at AIM Congress in Dubai, demonstrating potential uses in public safety, infrastructure monitoring and field operations.","category":"other","orgs":[{"id":"dubai-police","name":"Dubai Police"},{"id":"micropolis","name":"Micropolis Robotics"}],"also":0},{"id":"na69fe351c9","headline":"G42 weighs majority US ownership to safeguard AI-chip access","date":"2026-09-04","publisher":"Bloomberg","url":"https://www.bloomberg.com/news/articles/2026-09-04/abu-dhabi-s-g42-weighs-us-ownership-to-safeguard-ai-chip-access","summary":"G42 executives held exploratory talks about potentially selling a majority stake to American companies, as the company sought to secure access to advanced chips beyond the following year.","category":"geopolitics","orgs":[{"id":"g42","name":"G42"}],"also":0},{"id":"nce80d16186","headline":"K2 Horizon announced","date":"2026-09-03","publisher":"","url":"","summary":"The mission brief lists K2 Horizon on this date; it provides no further details.","category":"models","orgs":[],"also":1},{"id":"n1f6549288d","headline":"K2 Horizon model","date":"2026-09-03","publisher":"Mission brief","url":"","summary":"The mission brief identifies K2 Horizon as a UAE AI model release dated 2026-09-03.","category":"models","orgs":[{"id":"mbzuai","name":"Mohamed bin Zayed University of Artificial Intelligence"}],"also":1},{"id":"nc04cfa3448","headline":"MBZUAI introduces K2 Horizon open-model suite","date":"2026-09-03","publisher":"The National","url":"https://www.thenationalnews.com/future/technology/2026/09/03/mbzuai-k2-horizon-ai-open-model-uae/","summary":"MBZUAI and its Institute of Foundation Models released six fully open models ranging from 0.9B to 375B parameters, with weights, code, training data and methods disclosed.","category":"models","orgs":[{"id":"mbzuai","name":"Mohamed bin Zayed University of Artificial Intelligence"}],"also":1},{"id":"n223e575bd3","headline":"K2 Horizon introduced","date":"2026-09-03","publisher":"Mission brief","url":"","summary":"The mission brief lists K2 Horizon as a dated UAE-AI news event; it provides no further details.","category":"models","orgs":[],"also":0},{"id":"nf6de89a077","headline":"G42 explores raising billions of dollars","date":"2026-09-02","publisher":"Bloomberg","url":"https://www.bloomberg.com/news/articles/2026-09-02/microsoft-backed-ai-firm-g42-weighs-raising-billions-of-dollars","summary":"G42 held exploratory talks with potential investors about raising billions. The company already counts Mubadala Investment Company, Silver Lake and Microsoft among its investors; no final decision on size or structure was reported.","category":"funding","orgs":[{"id":"g42","name":"G42"},{"id":"mubadala","name":"Mubadala Investment Company"}],"also":0},{"id":"n3d1ea7dfb2","headline":"G42 announces investment by Silver Lake","date":"2026-09","publisher":"G42","url":"https://www.g42.ai/resources/news/g42-announces-investment-by-silver-lake","summary":"Silver Lake made a substantial investment in G42 to support expansion of its AI and cloud capabilities in the UAE and international markets; terms were undisclosed.","category":"funding","orgs":[{"id":"g42","name":"G42"}],"also":0},{"id":"n8207cb624a","headline":"Banco Santander and G42 sign memorandum of understanding","date":"2026-09","publisher":"G42","url":"https://www.g42.ai/resources/news/banco-santander-and-g42-sign-memorandum-understanding-explore-strategic-cooperation","summary":"G42 and Santander signed an MoU to explore AI-driven advisory and savings products and banking intelligence. The source describes September 2026 as the likely publication month; Inception and Presight are to play central roles.","category":"partnership","orgs":[{"id":"g42","name":"G42"},{"id":"inception","name":"Inception (Inception42, G42)"},{"id":"presight","name":"Presight AI Holding PLC"}],"also":0},{"id":"n4c9c12a238","headline":"Technology Innovation Institute appoints Ray O. Johnson as CEO","date":"2026-09","publisher":"Advanced Technology Research Council (ATRC)","url":"https://www.atrc.gov.ae/news/technology-innovation-institute-appoints-eminent-technologist-dr-ray-o-johnson-ceo","summary":"In September 2026, Dr Ray O. Johnson was appointed the first CEO of the Technology Innovation Institute.","category":"talent","orgs":[{"id":"atrc","name":"Advanced Technology Research Council"},{"id":"tii","name":"Technology Innovation Institute"}],"also":0},{"id":"n1ba1a6afab","headline":"Presight and Shorooq back Maven Robotics in its $100 million Series A","date":"2026-09","publisher":"AGBI","url":"https://www.agbi.com/tech/2026/09/abu-dhabi-companies-invest-in-us-startup-maven-robotics/","summary":"Presight and Shorooq invested in the industrial robot developerâ€™s Series A. Maven says its robots operate up to 16 hours daily at customer sites with reliability above 99%.","category":"funding","orgs":[{"id":"presight","name":"Presight AI Holding PLC"}],"also":0},{"id":"n0a26be41ad","headline":"M42 plans unified health data environment with Oracle Health","date":"2026-09","publisher":"Analytics Insight","url":"https://www.analyticsinsight.ae/artificial-intelligence/ai-healthcare-solutions-companies-platforms-emerging-technologies","summary":"M42 announced plans to adopt Oracle Health Data Intelligence with Oracle Health Foundation EHR, unifying clinical, genomic and real-world data for care, population health, precision medicine and research.","category":"health","orgs":[{"id":"m42","name":"M42"}],"also":0},{"id":"ncb41c8bc41","headline":"G42 and Santander sign strategic cooperation MoU","date":"2026-09","publisher":"G42","url":"https://www.g42.ai/resources/news/banco-santander-and-g42-sign-memorandum-understanding-explore-strategic-cooperation","summary":"G42 and Santander agreed to explore AI-driven advisory and savings products and banking intelligence; G42 units Inception and Presight were identified as central participants.","category":"partnership","orgs":[{"id":"g42","name":"G42"},{"id":"inception","name":"Inception (Inception42, G42)"},{"id":"presight","name":"Presight AI Holding PLC"}],"also":0},{"id":"n7ca8c802e8","headline":"UAE government services described as shifting toward proactive delivery","date":"2026-08-26","publisher":"Voice of Emirates","url":"https://www.voiceofemirates.com/en/emirates/2026/08/26/the-proactive-government-in-the-uae-a-service-before-you-even-ask-for-it/","summary":"The article describes UAE services initiated around life events and government-held data, rather than waiting for citizens to submit requests, and raises questions about data use and algorithmic errors.","category":"policy","orgs":[],"also":0},{"id":"ne99221ba51","headline":"Micropolis Robotics becomes an AI and robotics provider to ADNOC","date":"2026-08-24","publisher":"Micropolis","url":"https://investors.micropolis.ai/","summary":"Micropolis Robotics became a robotics and physical AI provider to ADNOC.","category":"partnership","orgs":[{"id":"adnoc","name":"Abu Dhabi National Oil Company (ADNOC)"},{"id":"micropolis","name":"Micropolis Robotics"}],"also":0},{"id":"n2559808604","headline":"Core42 AI Cloud supports MBZUAI research at scale","date":"2026-08-20","publisher":"Core42","url":"https://www.core42.ai/resource/blogs/mbzuai-engineering-the-future-of-ai-research-at-scale-with-core42-ai-cloud","summary":"Core42 described its sovereign AI Cloud supporting MBZUAI frontier-model training across different accelerators, including NVIDIA, AMD and Cerebras infrastructure.","category":"infrastructure","orgs":[{"id":"core42","name":"Core42"},{"id":"mbzuai","name":"Mohamed bin Zayed University of Artificial Intelligence"}],"also":0},{"id":"n11cb66443a","headline":"AIREV and Qualcomm agree to advance autonomous AI deployments","date":"2026-08-13","publisher":"Gulf News","url":"https://gulfnews.com/business/corporate-news/airev-and-qualcomm-to-advance-autonomous-ai-across-enterprise-and-government-environments-1.500639938","summary":"AIREV agreed to integrate its OnDemand platform with Qualcomm Dragonwing products, including the AI On-Prem Appliance, for enterprise and government deployments.","category":"partnership","orgs":[{"id":"airev","name":"AIREV"}],"also":0},{"id":"n25b4bc0186","headline":"Space42 reports H1 2026 results and growth in Smart Solutions","date":"2026-08-06","publisher":"Space42","url":"https://space42.ai/en/press-release/2026/space42-delivers-exceptional-h1-2026-results","summary":"Space42 reported USD 260 million H1 revenue, up 15% year-on-year, and said Smart Solutions growth was driven by government demand for geospatial intelligence and situational awareness.","category":"space","orgs":[{"id":"space42","name":"Space42 PLC"}],"also":0},{"id":"n3c45e3ae30","headline":"G42 joins Nvidiaâ€™s Open Secure AI Alliance","date":"2026-07-29","publisher":"EnterpriseAM","url":"https://enterpriseam.com/uae/2026/07/29/g42-joins-nvidias-alliance-for-open-source-ai/","summary":"G42 joined Nvidiaâ€™s Open Secure AI Alliance, which backs open-weight and open-source AI models and cybersecurity tools. The alliance plans to share tools for vulnerability discovery, AI-agent testing and defensive models.","category":"partnership","orgs":[{"id":"g42","name":"G42"}],"also":0},{"id":"n5e681d5ff0","headline":"AIREV and Redington agree to distribute OnDemand across the GCC and Africa","date":"2026-07-22","publisher":"TechAfrica News","url":"https://techafricanews.com/2026/07/22/airev-partners-with-redington-to-expand-uae-built-agentic-ai-across-gcc-and-africa/","summary":"AIREV and Redington agreed to distribute OnDemand Enterprise across the GCC and Africa, with software-only, self-hosted, and cloud-hosted deployment options and channel-partner services.","category":"partnership","orgs":[{"id":"airev","name":"AIREV"}],"also":0},{"id":"na86e52f6a3","headline":"e& UAE and Core42 partner to deliver sovereign AI infrastructure","date":"2026-07-20","publisher":"e& UAE","url":"https://www.eand.com/en/news/20-07-26-eand-uae-core42-sovereign-ai-infrastructure.html","summary":"The companies will co-deliver an in-country Sovereign AI Compute platform for enterprise and government, combining Core42â€™s sovereign AI cloud with e& UAEâ€™s national digital infrastructure.","category":"partnership","orgs":[{"id":"core42","name":"Core42"},{"id":"eand-enterprise","name":"e& enterprise"}],"also":1},{"id":"n1e489db231","headline":"UAE moves to BIS Country Group A:5","date":"2026-07-14","publisher":"Mission brief","url":"https://gulfbusinessreview.com/technology/uae-data-center-tracker-2026","summary":"The mission brief says the BIS move took effect on July 10, 2026, and was published on July 14, 2026.","category":"geopolitics","orgs":[{"id":"core42","name":"Core42"},{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"}],"also":7},{"id":"n6f5d840cd2","headline":"UAE moves to Country Group A:5 for advanced technology exports","date":"2026-07-14","publisher":"","url":"https://gulfbusinessreview.com/technology/uae-data-center-tracker-2026","summary":"The BIS moved the UAE to Country Group A:5 on July 10, 2026; the change was published July 14, 2026.","category":"policy","orgs":[{"id":"core42","name":"Core42"},{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"}],"also":1},{"id":"n2d02267e0e","headline":"Microsoft and G42 announce UAE data-centre expansion via Khazna","date":"2026-07","publisher":"G42","url":"https://www.g42.ai/resources/news/microsoft-and-g42-accelerate-uaes-digital-future-major-data-centre-expansion","summary":"The expansion adds 200 MW through Khazna Data Centers as part of Microsoftâ€™s stated US$15.2 billion UAE investment; capacity was expected online by the end of 2026.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"}],"also":0},{"id":"n5a1b8f833f","headline":"UAE announces $15.2 billion Microsoft investment and 200 MW expansion","date":"2026-07","publisher":"Mission brief","url":"https://www.g42.ai/resources/news/microsoft-and-g42-accelerate-uaes-digital-future-major-data-centre-expansion","summary":"The brief identifies Microsoftâ€™s $15.2 billion UAE investment and an additional 200 MW of capacity via Khazna Data Centers.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"khazna","name":"Khazna Data Centers"}],"also":0},{"id":"n0634d72bd1","headline":"Micropolis Robotics agrees to five-year Abu Dhabi sweeper deployment","date":"2026-06-16","publisher":"Micropolis","url":"https://micropolis.ai/","summary":"Micropolis Robotics signed a five-year agreement to deploy autonomous sweepers for the Abu Dhabi Government.","category":"partnership","orgs":[{"id":"micropolis","name":"Micropolis Robotics"}],"also":0},{"id":"ne6cdb8f994","headline":"UAE Artificial Intelligence and Data Authority announced","date":"2026-06-14","publisher":"UAE Cabinet","url":"https://uaecabinet.ae/en/news/mohammed-bin-rashid-approves-establishing-artificial-intelligence-and-data-authority","summary":"The mission brief lists the establishment or announcement of the UAE Artificial Intelligence and Data Authority on this date.","category":"policy","orgs":[{"id":"ai-data-authority","name":"Artificial Intelligence and Data Authority"}],"also":12},{"id":"n525a1bc6e6","headline":"Space42â€™s Foresight-3, Foresight-4 and Foresight-5 satellites become operational","date":"2026-06-09","publisher":"Space42","url":"https://space42.ai/en/press-release/2026/space42-expands-earth-observation-capabilities","summary":"Space42 said three new SAR satellites are operational, expanding its five-satellite constellation. Its GIQ platform processes satellite imagery into geospatial intelligence; the satellites were manufactured with ICEYE.","category":"space","orgs":[{"id":"space42","name":"Space42 PLC"}],"also":0},{"id":"na756b2600e","headline":"UAE pushes initiatives to develop AI unicorn companies","date":"2026-06-02","publisher":"intlbm.com","url":"https://intlbm.com/2026/06/02/uae-boosts-initiatives-to-develop-ai-unicorn-companies/","summary":"The article describes a policy push to foster AI unicorns, reporting three AI unicorns in the UAE and 673 AI companies in Abu Dhabi, with 150 new firms launched there in H1 2025.","category":"policy","orgs":[{"id":"dcai","name":"Dubai Centre for Artificial Intelligence"},{"id":"g42","name":"G42"},{"id":"hub71","name":"Hub71"},{"id":"xpanceo","name":"XPANCEO"}],"also":0},{"id":"n63565a5051","headline":"Positron AI establishes its first presence outside the US at DIFC","date":"2026-06-01","publisher":"DIFC","url":"https://www.difc.com/whats-on/news/positron-ai-establishes-first-presence-outside-the-us-in-difc?trk=article-ssr-frontend-pulse_little-text-block&utm_source=openai","summary":"Positron AI established a regional presence at DIFC under the Dubai AI Licence, focused on power-efficient, scalable AI inference infrastructure.","category":"infrastructure","orgs":[{"id":"dubai-ai-campus","name":"Dubai AI Campus"},{"id":"positron","name":"Positron AI Ltd"}],"also":0},{"id":"n137e4c5070","headline":"M42 and Qritive introduce AI-based prostate cancer diagnostics","date":"2026-06","publisher":"Analytics Insight","url":"https://www.analyticsinsight.ae/artificial-intelligence/ai-healthcare-solutions-companies-platforms-emerging-technologies","summary":"M42â€™s National Reference Laboratory worked with Qritive to introduce AI-based prostate cancer diagnostics in the UAE, providing pathologists additional analysis while doctors retain clinical authority.","category":"health","orgs":[{"id":"m42","name":"M42"}],"also":0},{"id":"ndbe92cb2dd","headline":"Saal.ai raises a $60 million Series A","date":"2026-06","publisher":"DXBStart","url":"https://www.dxbstart.com/sector/ai","summary":"Saal.ai raised a $60 million Series A led by AI71 and BlueFive Capital, according to the cited listing.","category":"funding","orgs":[{"id":"ai71","name":"AI71"},{"id":"saal-ai","name":"Saal.ai"}],"also":0},{"id":"n01e15bb70d","headline":"UAE launches guide to generative AI applications","date":"2026-05-10","publisher":"Middle East AI News","url":"https://www.middleeastainews.com/p/uae-ai-office-publishes-practical","summary":"The UAE AI Office released an Arabic- and English-language guide covering 19 generative AI use cases, with practical examples, best practices and recommendations for selecting tools.","category":"policy","orgs":[],"also":0},{"id":"nd5703e37fe","headline":"Micropolis Robotics signs $1.2 million EMSTEEL agreement","date":"2026-05-04","publisher":"Micropolis","url":"https://micropolis.ai/","summary":"Micropolis Robotics signed a $1.2 million agreement with EMSTEEL to expand its industrial automation footprint.","category":"partnership","orgs":[{"id":"micropolis","name":"Micropolis Robotics"}],"also":0},{"id":"nb71ad9cd26","headline":"TII launches Falcon Perception multimodal AI model","date":"2026-05-03","publisher":"Technology Innovation Institute (TII)","url":"https://www.tii.ae/news/tii-launches-falcon-perception-new-multimodal-ai-model-helps-machines-see-and-understand-world","summary":"Falcon Perception combines vision and language, including prompt-based object segmentation. The report describes a model of about 600 million parameters for robotics, document processing and industrial uses.","category":"models","orgs":[{"id":"atrc","name":"Advanced Technology Research Council"},{"id":"tii","name":"Technology Innovation Institute"}],"also":1},{"id":"n734e99cdff","headline":"Abu Dhabi announces intelligent surgical network with Johnson & Johnson","date":"2026-05","publisher":"Analytics Insight","url":"https://www.analyticsinsight.ae/artificial-intelligence/ai-healthcare-solutions-companies-platforms-emerging-technologies","summary":"The Department of Health â€“ Abu Dhabi announced a surgical network with Johnson & Johnson, using the Polyphonic digital ecosystem and technology from AWS, NVIDIA and Core42 to connect operating rooms.","category":"health","orgs":[{"id":"core42","name":"Core42"},{"id":"doh-abu-dhabi","name":"Department of Health â€“ Abu Dhabi"}],"also":0},{"id":"ne39aad5452","headline":"UAE announces plan for agentic AI across government services","date":"2026-04-23","publisher":"Fox News","url":"https://www.foxnews.com/tech/united-arab-emirates-plans-ai-run-government-within-two-years","summary":"The mission brief says the plan targets using agentic AI for 50% of government services by 2028.","category":"policy","orgs":[{"id":"ai-data-authority","name":"Artificial Intelligence and Data Authority"}],"also":16},{"id":"n16941e26a3","headline":"UAE government targets agentic AI in half of services by 2028","date":"2026-04-23","publisher":"","url":"","summary":"The mission brief says the UAE set a goal for agentic AI to support 50% of government services by 2028.","category":"policy","orgs":[],"also":3},{"id":"n2c8dd50a24","headline":"Derqâ€™s AI edge system targets traffic and pedestrian safety","date":"2026-03-11","publisher":"Derq","url":"https://en.derq.com/press-coverage/derq-edge-ai-system-improves-traffic-safety","summary":"Derqâ€™s edge appliance uses NVIDIA GPUs to process camera and radar data, predict crashes and warn connected road users; the system also supports traffic counts and identification of crash-prone road locations.","category":"other","orgs":[{"id":"derq","name":"Derq"}],"also":0},{"id":"n7510b407c9","headline":"PureHealth reports AI healthcare initiatives and facility energy optimisation","date":"2026-03","publisher":"PureHealth","url":"https://purehealth.ae/wp-content/uploads/2026/03/PureHealth_Integrated-Annual-Report_2025_EN.pdf","summary":"PureHealthâ€™s 2025 report describes a healthcare AI laboratory, clinical assistant Nada, digital health platform Pura, and AI-enabled IoT energy optimisation deployed across ten facilities, reducing annual consumption by over 13 million kWh.","category":"health","orgs":[{"id":"purehealth","name":"PureHealth"}],"also":0},{"id":"n8cd4d86cb3","headline":"G42 and Cerebras unveil a four-trillion-transistor AI chip at WGS 2026","date":"2026-02-05","publisher":"Gulf News","url":"https://gulfnews.com/uae/uae-launches-worlds-largest-ai-chip-with-4-trillion-transistors-at-wgs-2026-1.500432873","summary":"G42 and Cerebras co-developed a wafer-scale chip with more than four trillion transistors, unveiled at the World Governments Summit. The chip is intended for G42â€™s AI factory and 5GW UAEâ€“US AI Campus.","category":"infrastructure","orgs":[{"id":"cerebras-uae","name":"Cerebras Systems"},{"id":"g42","name":"G42"}],"also":0},{"id":"nab89b70448","headline":"EDGE, TII, Micropolis and SteerAI agree to deploy an autonomous logistics platform","date":"2026-01","publisher":"EDGE Group","url":"https://edgegroup.ae/news/edge-tii-micropolis-and-steerai-deploy-advanced-autonomous-logistics-platform","summary":"EDGE Group, TII, Micropolis and SteerAI agreed to deploy an autonomous logistics platform using AI software for navigation, fleet management and safety.","category":"partnership","orgs":[{"id":"edge","name":"EDGE Group"},{"id":"micropolis","name":"Micropolis Robotics"},{"id":"steerai","name":"SteerAI"},{"id":"tii","name":"Technology Innovation Institute"}],"also":0},{"id":"na1533d46b5","headline":"Stargate UAE 1GW project and first 200MW phase","date":"2026","publisher":"Mission brief","url":"","summary":"The brief describes a 1GW Stargate UAE project within a 5GW UAE-US AI Campus, with G42 building, OpenAI and Oracle operating, and the first 200MW expected in 2026; it also names NVIDIA GB300, Cisco and SoftBank.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"m42","name":"M42"}],"also":1},{"id":"n5eedbdf3ca","headline":"Cerebras 4-trillion-transistor chip at World Governments Summit","date":"2026","publisher":"Mission brief","url":"","summary":"The brief identifies a Cerebras 4-trillion-transistor chip at World Governments Summit 2026.","category":"models","orgs":[{"id":"cerebras-uae","name":"Cerebras Systems"}],"also":0},{"id":"neeb9258154","headline":"EDGE Group at ADEX 2026","date":"2026","publisher":"Mission brief","url":"","summary":"The brief identifies EDGE Group at ADEX 2026; it provides no further detail about the announcement or activity.","category":"defence","orgs":[{"id":"edge","name":"EDGE Group"}],"also":1},{"id":"n3af985f719","headline":"GITEX GLOBAL 2026 scheduled for 7â€“11 December 2026 at Expo City Dubai (moved from October / DWTC)","date":"2026-12-07","publisher":"GITEX","url":"https://www.gitex.com","summary":"GITEX GLOBAL 2026 runs 7â€“11 December 2026 at Expo City Dubai. October 2026 items are therefore not 'at GITEX'; Ai Everything Abu Dhabi was 6â€“7 Oct 2026 at ADNEC.","category":"other","orgs":[],"also":0},{"id":"n1af0ab7aca","headline":"Cerebras presented a 4-trillion-transistor chip at WGS 2026","date":"2026","publisher":"Mission brief","url":"","summary":"The mission brief notes that Cerebras presented a chip with 4 trillion transistors at WGS 2026.","category":"models","orgs":[{"id":"cerebras-uae","name":"Cerebras Systems"}],"also":0},{"id":"naf52f1a41f","headline":"PureHealth launches AI-powered diagnostic mega lab","date":"2025-12-11","publisher":"TechAfricaNews","url":"https://techafricanews.com/2025/12/11/purehealth-launches-ai-powered-diagnostic-mega-lab-to-transform-uae-healthcare/","summary":"PureHealth launched a 70,000-square-foot AI-powered diagnostic lab through subsidiary PureLab, combining automation, robotics and real-time quality control. It can process more than 30 million samples annually.","category":"health","orgs":[{"id":"doh-abu-dhabi","name":"Department of Health â€“ Abu Dhabi"},{"id":"purehealth","name":"PureHealth"}],"also":0},{"id":"n21e7cd2311","headline":"UAE government AI utilisation reaches 97%","date":"2025-12","publisher":"UPPERSETUP","url":"https://uppersetup.com/en/article/ai-business-in-the-uae-2026-unicorn-30-stargate-uae-difc-ai","summary":"The article reports that, as of December 2025, AI utilisation across UAE government entities had reached 97%; it also says the developer pool exceeded 450,000 programmers.","category":"policy","orgs":[],"also":0},{"id":"nce70c3597f","headline":"XPANCEO and MBRSC conduct smart contact lens ground testing","date":"2025-12","publisher":"Wikipedia","url":"https://en.wikipedia.org/wiki/Xpanceo","summary":"XPANCEO conducted ground testing of an augmented-reality smart contact lens with the Mohammed Bin Rashid Space Centre; possible in-orbit testing was also noted.","category":"space","orgs":[{"id":"xpanceo","name":"XPANCEO"}],"also":0},{"id":"nb55a7c4d38","headline":"G42 receives U.S. approval for advanced AI chip exports","date":"2025-11-20","publisher":"Gulf News","url":"https://gulfnews.com/business/economy/g42-gets-us-approval-for-advanced-ai-chip-exports-1.500353606","summary":"The U.S. approved G42 to receive AI-chip computing capacity equivalent to 35,000 Nvidia GB300 processors, subject to security and reporting requirements.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"}],"also":1},{"id":"ncbd948cf5f","headline":"G42â€™s Stargate UAE forms part of the planned 5-gigawatt UAEâ€“U.S. AI Campus","date":"2025-11-20","publisher":"Gulf News","url":"https://gulfnews.com/business/economy/g42-gets-us-approval-for-advanced-ai-chip-exports-1.500353606","summary":"The article described Stargate UAE as a 1-gigawatt AI compute cluster being built by G42 for OpenAI with Oracle, Cisco, NVIDIA and SoftBank, within the larger UAEâ€“U.S. AI Campus.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"m42","name":"M42"}],"also":0},{"id":"nc4d8b44d2e","headline":"G42 export approval for 35,000 GB300-equivalent units","date":"2025-11","publisher":"Mission brief","url":"","summary":"The mission brief lists a G42 export approval covering 35,000 GB300-equivalent units in November 2025.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"}],"also":6},{"id":"na781df21dd","headline":"G42 receives US approval for up to 35,000 advanced AI chips, enabling Stargate UAE deployment","date":"2025-11","publisher":"CNBC","url":"https://www.cnbc.com/video/2025/11/21/exclusive-uaeas-g42-secures-nvidias-most-advanced-ai-chips.html","summary":"The US approved G42 to buy up to 35,000 advanced AI chips. The approval enables deployment of Stargate UAE, a 1GW cluster G42 is building for OpenAI with Oracle, Cisco, NVIDIA and SoftBank Group.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"m42","name":"M42"}],"also":0},{"id":"n5c5d9f78a7","headline":"UAE Council for Artificial Intelligence and Blockchain reviews national projects at GITEX Global 2025","date":"2025-10-19","publisher":"WAM","url":"https://www.wam.ae/en/article/bma7sp4-uae-council-for-artificial-intelligence-and","summary":"Chaired by Omar Sultan Al Olama, the Council reviewed national AI and advanced-technology projects and explored collaboration and knowledge exchange with global platforms and companies at GITEX Global 2025.","category":"policy","orgs":[],"also":0},{"id":"n9f49268f40","headline":"MBZUAI and G42 launch K2 Think reasoning model","date":"2025-09-09","publisher":"Mohamed bin Zayed University of Artificial Intelligence","url":"https://mbzuai.ac.ae/news-events/news/mbzuai-g42-launch-k2-think-leading-open-source-system-advanced-ai-reasoning","summary":"MBZUAIâ€™s Institute of Foundation Models and G42 launched K2 Think, a 32-billion-parameter open-source reasoning system using supervised fine-tuning, verifiable-reward reinforcement learning, agentic planning, and test-time scaling.","category":"models","orgs":[{"id":"g42","name":"G42"},{"id":"mbzuai","name":"Mohamed bin Zayed University of Artificial Intelligence"}],"also":0},{"id":"nb0e926593d","headline":"Presightâ€“Shorooq Fund I launches with $100 million target","date":"2025-09","publisher":"Analytics Insight","url":"https://www.analyticsinsight.ae/artificial-intelligence/top-ai-companies-and-startups-driving-uaes-tech-growth","summary":"The fund, a collaboration between G42 and Shorooq Partners, targets frontier intelligence including sovereign AI cloud, agentic reasoning and physical AI. It evaluated more than 1,000 companies before making its first five investments.","category":"funding","orgs":[{"id":"g42","name":"G42"},{"id":"presight","name":"Presight AI Holding PLC"}],"also":0},{"id":"nced20090e1","headline":"XPANCEO and Intra-Ker launch intracorneal implant proof of concept","date":"2025-09","publisher":"Wikipedia","url":"https://en.wikipedia.org/wiki/Xpanceo","summary":"XPANCEO and Italian medtech company Intra-Ker began a joint proof of concept for an intracorneal implant.","category":"partnership","orgs":[{"id":"xpanceo","name":"XPANCEO"}],"also":0},{"id":"n32d1811352","headline":"Hub71 announces its 17th cohort, including AI startups","date":"2025-09","publisher":"Abu Dhabi Media Office","url":"https://www.mediaoffice.abudhabi/en/technology/hub71-welcomes-record-number-of-ai-startups-to-its-17th-cohort/","summary":"Hub71â€™s 17th cohort included AI-related startups Harmonic Discovery, Planys Technologies and eVoost AI.","category":"talent","orgs":[{"id":"hub71","name":"Hub71"}],"also":0},{"id":"n5b73286426","headline":"XPANCEO raises $250 million Series A at a $1.35 billion valuation","date":"2025-07-08","publisher":"XPANCEO","url":"https://www.xpanceo.com/newsroom/xpanceo-becomes-a-unicorn-with-250m-raise","summary":"Dubai-based XPANCEO closed a $250 million Series A led by Opportunity Venture (Asia) to advance its AI-powered smart contact lens, which combines XR, health monitoring, night vision and zoom.","category":"funding","orgs":[{"id":"xpanceo","name":"XPANCEO"}],"also":2},{"id":"nac479b262b","headline":"U.S.-UAE AI alliance draws investment and technology focus","date":"2025-05-28","publisher":"CNBC","url":"https://www.cnbc.com/2025/05/28/the-us-ai-love-affair-with-the-uae-boils-down-to-dominance.html","summary":"CNBC described aligned U.S. and UAE ambitions in AI, with investment pledges focused on technology and the UAE seeking advanced compute and talent for its sovereign AI goals.","category":"geopolitics","orgs":[],"also":0},{"id":"n411cd8c004","headline":"Stargate UAE announced as a 1GW AI compute cluster","date":"2025-05-22","publisher":"OpenAI","url":"https://openai.com/index/introducing-stargate-uae/","summary":"OpenAI announced Stargate UAE with G42, Oracle, NVIDIA, Cisco and SoftBank. G42 will build the 1GW Abu Dhabi cluster; OpenAI and Oracle will operate it, with the first 200MW expected to go live in 2026.","category":"infrastructure","orgs":[{"id":"g42","name":"G42"},{"id":"m42","name":"M42"}],"also":1},{"id":"ndbae470a43","headline":"M42 appoints Dimitris Moulavasilis as Group CEO","date":"2025-05","publisher":"M42","url":"https://m42.ae/media-resources/news/m42-appoints-dimitris-moulavasilis-as-group-ceo/","summary":"M42 appointed Dimitris Moulavasilis Group CEO in May 2025; Hasan Jasem Al Nowais stepped down as CEO and became a board member.","category":"other","orgs":[{"id":"m42","name":"M42"}],"also":0},{"id":"n5bf925e8a5","headline":"Report raises human-rights concerns about AI surveillance in the UAE","date":"2025-04-17","publisher":"ADHRB","url":"https://www.adhrb.org/2025/04/the-rise-of-ai-surveillance-in-the-uae-implications-for-human-rights/","summary":"The report discusses UAE AI surveillance deployment and concerns about privacy, freedom of expression, and potential governmental overreach.","category":"policy","orgs":[],"also":0},{"id":"n8c1286d91d","headline":"Micropolis Robotics lists on NYSE American","date":"2025-03-07","publisher":"Stock Analysis","url":"https://stockanalysis.com/stocks/mcrp/company/","summary":"Micropolis Robotics became publicly listed on NYSE American under ticker MCRP.","category":"funding","orgs":[{"id":"micropolis","name":"Micropolis Robotics"}],"also":0},{"id":"n9b2f2e1e09","headline":"UAE AI startups secured $519 million in 2025","date":"2025","publisher":"FounderConnects","url":"https://www.founderconnects.com/blog/uae-investors-support-ai-startups","summary":"FounderConnects reports that UAE AI startups raised $519 million in 2025, accounting for 60% of regional AI funding and representing 267% growth from the previous year.","category":"funding","orgs":[],"also":0},{"id":"nf99bc68c50","headline":"Dubai AI Festival 26â€“27 October at DWTC (Dubai AI Campus / DIFC): 100+ countries, 150+ speakers, 500 investors","date":"2026-10-20","publisher":"WAM","url":"https://www.wam.ae/en/article/dubai-ai-festival-2026-october","summary":"Dubai AI Festival, organised with the Dubai AI Campus (DIFC), will run 26â€“27 Oct 2026 at Dubai World Trade Centre with participants from 100+ countries, 150+ speakers and 500 investors.","category":"event","orgs":[{"id":"dubai-ai-campus","name":"Dubai AI Campus"},{"id":"dcai","name":"Dubai Centre for Artificial Intelligence"}],"also":0},{"id":"nc7da1a5631","headline":"TII researchers' plant-waste gel cuts irrigation water use by ~30%","date":"2026-10-19","publisher":"Khaleej Times","url":"https://www.khaleejtimes.com/uae/tii-plant-waste-gel-irrigation-water-solar-panels","summary":"A TII team developed a gel from plant waste that reduces irrigation water use by about 30%; AI was used to identify molecules that protect solar panels.","category":"research","orgs":[{"id":"tii","name":"Technology Innovation Institute"}],"also":0},{"id":"n9ac160239c","headline":"G42 welcomes US approval for advanced AI chip exports (Peng Xiao, Khaldoon Al Mubarak)","date":"2026-10-20","publisher":"G42","url":"https://www.g42.ai/resources/news/us-approval-advanced-ai-chip-exports-2026","summary":"G42 statement on US approval for advanced AI chip exports, with quotes from CEO Peng Xiao and Khaldoon Al Mubarak; G42 also announced an Assurance Compute Framework (Talal Al Kaissi).","category":"policy","orgs":[{"id":"g42","name":"G42"},{"id":"core42","name":"Core42"}],"also":0},{"id":"n9bfd3e4f61","headline":"Federal AI agent control tower and the livelihood 'red line': no AI agent may decide on a person's livelihood","date":"2026-10-14","publisher":"Khaleej Times","url":"https://www.khaleejtimes.com/uae/ai-minister-agents-jobs-livelihood-technology-control","summary":"Omar Sultan Al Olama: no AI agent will be allowed to make decisions affecting a person's livelihood; ~50% of federal services via agents, ~30% ruled out; every agent plugs into a government control tower with continuous audits (also Trends MENA, Emirates 24|7).","category":"policy","orgs":[{"id":"ai-data-authority","name":"Artificial Intelligence and Data Authority"}],"also":0},{"id":"ncfc61d3ada","headline":"Ai Everything Abu Dhabi (ADNEC, 6â€“7 Oct): UAE training ~80,000 government employees as AI 'super users'; Core42 on sovereign-AI export","date":"2026-10-06","publisher":"Ai Everything Abu Dhabi","url":"https://www.computerweekly.com/news/ai-everything-abu-dhabi-2026-core42-sovereign-ai","summary":"UAE is training ~80,000 government employees as AI super users; Al Olama on one-person companies 'plus agents'; Talal Al Kaissi (Core42) on the UAE as an 'open lab' and sovereign-AI export (Computer Weekly, 7 Oct).","category":"event","orgs":[{"id":"core42","name":"Core42"},{"id":"ai-data-authority","name":"Artificial Intelligence and Data Authority"},{"id":"dge","name":"Department of Government Enablement (DGE), Abu Dhabi"}],"also":0},{"id":"n4ad27bc47b","headline":"Abu Dhabi AiNative training week (week of 8 Oct 2026)","date":"2026-10-08","publisher":"Abu Dhabi Media Office","url":"https://www.mediaoffice.abudhabi/en/ainative-training-week-2026","summary":"Government AI-native training week in Abu Dhabi.","category":"talent","orgs":[{"id":"dge","name":"Department of Government Enablement (DGE), Abu Dhabi"}],"also":0},{"id":"na28b8ee0af","headline":"K2 Horizon: IFM releases a connected fleet of six fully open models","date":"2026-09-03","publisher":"IFM / MBZUAI","url":"https://news.ycombinator.com/item?id=49551760","summary":"Institute of Foundation Models releases K2 Horizon (fully open: corpus, recipe, scripts, checkpoints); HN thread 335 points / 131 comments.","category":"models","orgs":[{"id":"ifm","name":"Institute of Foundation Models (IFM), Mohamed bin Zayed University of Artificial Intelligence"},{"id":"mbzuai","name":"Mohamed bin Zayed University of Artificial Intelligence"}],"also":0},{"id":"n35d5014be3","headline":"G42 explores multibillion-dollar raise (reported, unconfirmed)","date":"2026-09-02","publisher":"Bloomberg","url":"https://www.bloomberg.com/news/articles/2026-09-02/g42-explores-multibillion-raise","summary":"Bloomberg 2 Sep 2026 â€” exploratory raise; 4â€“5 Sep â€” possible majority stake to US companies tied to chip-access rules expiring ~Apr 2027. Reported, unconfirmed; no deal closed or denied as of 21 Oct 2026.","category":"investment","orgs":[{"id":"g42","name":"G42"}],"also":0},{"id":"ne443c370dc","headline":"US BIS reclassifies UAE to EAR Country Group A:5 (license-free advanced computing for UAE Government and approved entities)","date":"2026-07-10","publisher":"US BIS","url":"https://www.bis.gov/press-release/uae-country-group-a5-2026","summary":"Removes the UAE from D:3/D:4; advanced computing items license-free for the UAE Government and approved entities.","category":"policy","orgs":[{"id":"g42","name":"G42"},{"id":"core42","name":"Core42"},{"id":"khazna","name":"Khazna Data Centers"}],"also":0},{"id":"nde3d35bc8d","headline":"Cooper Fitch 'AI & the Future of Talent 2027': 14% expect AI-related role reductions in 12â€“24 months (down from 31%)","date":"2026-09-13","publisher":"Khaleej Times","url":"https://www.khaleejtimes.com/jobs/cooper-fitch-ai-future-of-talent-2027","summary":"57% have no formal or only informal AI governance (an Instagram repost states 81% no formal framework / 10% fully established â€” discrepancy flagged, both cited).","category":"survey","orgs":[],"also":0},{"id":"n14ba1b8751","headline":"H.E. Dr Thani bin Ahmed Al Zeyoudi, Minister of Foreign Trade, named AIREV Chairman","date":"2026-06-23","publisher":"WAM","url":"https://www.wam.ae/en/article/airev-chairman-al-zeyoudi-2026-06-23","summary":"WAM 23 Jun 2026.","category":"leadership","orgs":[{"id":"airev","name":"AIREV"}],"also":0},{"id":"n4d4d5caab1","headline":"Intel and AIREV launch fully on-device AI-PC agents (Intel Core Ultra)","date":"2025-12-18","publisher":"GEC Newswire","url":"https://gecnewswire.com/airev-intel-on-device-ai-agents","summary":"On-device agents with Intel Core Ultra; Greg Ernst / Taha Khalifa quotes.","category":"partnership","orgs":[{"id":"airev","name":"AIREV"}],"also":0},{"id":"n49c027fff5","headline":"AIREV and Intel sign MoU at GITEX GLOBAL 2025","date":"2025-10-14","publisher":"Middle East AI News","url":"https://www.middleeastainews.com/p/airev-intel-mou-gitex-2025","summary":"MoU signed at GITEX GLOBAL 2025 (Oct 2025, DWTC).","category":"partnership","orgs":[{"id":"airev","name":"AIREV"}],"also":0},{"id":"n100648715d","headline":"AIREV partners with Tenstorrent to advance UAE-developed agentic AI for global deployment","date":"2025-06-25","publisher":"Tenstorrent","url":"https://tenstorrent.com/vision/airev-partners-with-tenstorrent","summary":"Tenstorrent agentic-AI stack partnership.","category":"partnership","orgs":[{"id":"airev","name":"AIREV"}],"also":0}],"categories":["infrastructure","models","partnership","policy","funding","other","health","talent","space","geopolitics","defence","event","research","investment","survey","leadership"]}]],null,"$L1e"]}]
